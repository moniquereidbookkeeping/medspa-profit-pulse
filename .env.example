# Copy to .env.local for local development. Never commit real values.
# In production, set these in Cloudflare Pages: Settings > Variables and Secrets.

# ---- Required for saving leads (Cloudflare Pages, runtime) ------------------------------
# Your Google Apps Script web-app URL (the one that writes to the Submissions tab).
APPS_SCRIPT_URL=""
# Shared secret that your Apps Script checks before saving a row.
REPORT_SHARED_SECRET=""

# ---- Optional: bot protection (free, Cloudflare Turnstile) -----------------------------
# Create a widget at dash.cloudflare.com > Turnstile. Set BOTH values to switch it on.
# Site key: public, shown to the browser by /api/config (runtime variable, no rebuild needed).
TURNSTILE_SITE_KEY=""
# Secret key: private, used only by /api/report (runtime secret).
TURNSTILE_SECRET_KEY=""

# ---- Optional: funnel analytics (build variables) ---------------------------------------
# Your Plausible domain, e.g. medspa.moniquereidbookkeeping.com. Leave empty to send nothing.
VITE_PLAUSIBLE_DOMAIN=""
# Only if you self-host Plausible:
VITE_ANALYTICS_SCRIPT_SRC=""
